<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="2dp">
            <ImageView android:id="@+id/accent_bar" android:layout_width="4dp" android:layout_height="30dp" android:src="@drawable/widget_pill" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:id="@+id/project" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_text" android:textSize="15sp" android:textStyle="bold" android:text="@string/app_name" />
                <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_text2" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="8dp" android:textColor="@color/widget_text2" android:textSize="12sp" />
            <ImageView android:id="@+id/ring" android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="no" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="4dp" android:background="@color/widget_rim_soft" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingTop="6dp" android:text="@string/widget_all_done" android:textColor="@color/widget_text2" android:textSize="13sp" android:visibility="gone" />
        <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/check0" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/widget_check" android:contentDescription="@string/widget_tick" />
            <TextView android:id="@+id/title0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="4dp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_text" android:textSize="13.5sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/check1" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/widget_check" android:contentDescription="@string/widget_tick" />
            <TextView android:id="@+id/title1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="4dp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_text" android:textSize="13.5sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/check2" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/widget_check" android:contentDescription="@string/widget_tick" />
            <TextView android:id="@+id/title2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="4dp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_text" android:textSize="13.5sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/check3" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/widget_check" android:contentDescription="@string/widget_tick" />
            <TextView android:id="@+id/title3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="4dp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_text" android:textSize="13.5sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/check4" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/widget_check" android:contentDescription="@string/widget_tick" />
            <TextView android:id="@+id/title4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="4dp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_text" android:textSize="13.5sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/check5" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/widget_check" android:contentDescription="@string/widget_tick" />
            <TextView android:id="@+id/title5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="4dp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_text" android:textSize="13.5sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row6" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/check6" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/widget_check" android:contentDescription="@string/widget_tick" />
            <TextView android:id="@+id/title6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="4dp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_text" android:textSize="13.5sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row7" android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:id="@+id/check7" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/widget_check" android:contentDescription="@string/widget_tick" />
            <TextView android:id="@+id/title7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="4dp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_text" android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
