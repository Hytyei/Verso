{
  "name": "verso-api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute verso --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute verso --local --file=schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --experimental-sqlite --no-warnings test/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
